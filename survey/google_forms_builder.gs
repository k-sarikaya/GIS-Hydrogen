/**
 * GH2 uzman anketi — Google Forms'u otomatik oluşturur (sürüm 2.0, Türkçe).
 *
 * Kurulum:
 *  1. Konum haritası bu dosyanın sonundaki SITE_MAP_PNG_B64 sabitine gömülüdür; Drive'a yükleme gerekmez
 *     (kaynak: survey/assets/site_map_small.png, survey/make_site_map.py ile üretilir).
 *  2. Köşeli parantezli alanları doldurun (ARASTIRMACI, SAKLAMA_YIL).
 *  3. https://script.google.com → Yeni proje → bu dosyanın içeriğini yapıştırın → buildForm'u
 *     çalıştırın → izinleri onaylayın. Günlükte (Yürütme günlüğü) düzenleme ve yanıt bağlantıları yazılır.
 *  4. Formda elle yapılacaklar (Apps Script API'si desteklemiyor):
 *     - C, D1, D2, D3 ızgaralarında ⋮ → "Satır sırasını karıştır" açın.
 *     - Ayarlar → Yanıtlar → "E-posta adreslerini topla": Kapalı olduğunu kontrol edin.
 *  5. 2–3 uzmanla pilot uygulama yapın; ardından bağlantıyı davet metniyle gönderin.
 *
 * İçeriğin tek kaynağı survey/Uzman_Anket_Formu_TR.md dosyasıdır; metin değişirse bu dosya da güncellenmelidir.
 */

const ARASTIRMACI = 'Dr. Öğr. Üyesi Kadir SARIKAYA, Tokat Gaziosmanpaşa Üniversitesi, Endüstri Mühendisliği Bölümü, kadir.sarikaya@gop.edu.tr';
const SAKLAMA_YIL = '5';

// Satır etiketi: kod + il/ilçe (katılımcı haritaya dönmeden hatırlasın; analiz kodu 'S1' önekini okur)
const SITES = ['S1 — Karaman / Merkez', 'S2 — Kahramanmaraş / Afşin', 'S3 — Şanlıurfa / Viranşehir',
               'S4 — Kayseri / Develi', 'S5 — Kırklareli / Pınarhisar'];
const SCALE9 = ['1', '2', '3', '4', '5', '6', '7', '8', '9'];
const SCALE9_NB = SCALE9.concat(['Bilgim yok']);

function buildForm() {
  const form = FormApp.create('Yeşil Hidrojen Üretim Tesisi Yer Seçimi — Uzman Değerlendirmesi');
  form.setDescription(
    'Bu form, Tokat Gaziosmanpaşa Üniversitesi Endüstri Mühendisliği Bölümü\'nde yürütülen akademik bir çalışma ' +
    'için hazırlanmıştır. Türkiye genelinde coğrafi bilgi sistemleri analiziyle belirlenen beş aday yeşil hidrojen ' +
    'üretim sahası, yedi kriter üzerinden iki adımda değerlendirilmektedir: (1) kriterlerin önemi, (2) uzman görüşü ' +
    'gerektiren üç kriter açısından sahaların puanlanması. Tüm sorularda 9 en elverişli durumu gösterir. ' +
    'Tahmini süre 15–20 dakikadır.');
  form.setCollectEmail(false);
  form.setProgressBar(true);
  form.setAllowResponseEdits(false);
  form.setConfirmationMessage('Katkılarınız için teşekkür ederiz. Çalışmanın sonuçlarını talep etmeniz halinde paylaşmaktan memnuniyet duyarız.');

  // ── Aydınlatma ve onam ─────────────────────────────────────────────
  form.addSectionHeaderItem()
    .setTitle('Aydınlatma metni')
    .setHelpText(
      'Veri sorumlusu: ' + ARASTIRMACI + '.\n\n' +
      'İşlenen veriler: kurum türü, uzmanlık alanı, deneyim süresi, bölgeleri tanıma düzeyi ve değerlendirmeleriniz; ' +
      'ad-soyad isteğe bağlıdır, e-posta toplanmaz.\n' +
      'Amaç: yalnızca bu akademik çalışma; sonuçlar toplu ve anonim olarak raporlanır.\n' +
      'Hukuki sebep: değerlendirmeler 6698 sayılı KVKK md. 28 uyarınca araştırma amacıyla anonimleştirilerek işlenir; ' +
      'isteğe bağlı ad-soyad açık rızanıza dayanır.\n' +
      'Aktarım: form Google Forms (Google LLC) üzerinden yürütülür; yanıtlar yurt dışındaki sunucularda saklanabilir (KVKK md. 9).\n' +
      'Saklama: anonim veri seti yayından sonra ' + SAKLAMA_YIL + ' yıl saklanır; ad-soyad veri toplama bitince silinir.\n' +
      'Haklarınız: KVKK md. 11 kapsamındaki haklarınız için yukarıdaki adrese başvurabilirsiniz. Katılım gönüllüdür.');
  form.addCheckboxItem()
    .setTitle('Onam')
    .setChoiceValues([
      'Aydınlatma metnini okudum ve gönüllü olarak katılmayı kabul ediyorum.',
      'Yanıtlarımın Google Forms hizmeti aracılığıyla yurt dışındaki sunucularda saklanmasına açık rıza veriyorum.'])
    .setValidation(FormApp.createCheckboxValidation().requireSelectAtLeast(2).build())
    .setRequired(true);

  // ── Bölüm A — Uzman profili ───────────────────────────────────────
  form.addPageBreakItem().setTitle('Bölüm A — Uzman profili');
  form.addTextItem().setTitle('A1. Ad-soyad (isteğe bağlı)');
  form.addMultipleChoiceItem().setTitle('A2. Kurum türü')
    .setChoiceValues(['Akademi', 'Kamu / bakanlık', 'Düzenleyici kurum veya iletim sistemi işletmecisi (EPDK, TEİAŞ vb.)',
      'Enerji / hidrojen sanayi', 'Proje geliştirici / EPC', 'Kalkınma ajansı / yerel yönetim', 'STK / çevre', 'Finans'])
    .showOtherOption(true).setRequired(true);
  form.addCheckboxItem().setTitle('A3. Uzmanlık alanı (birden fazla seçilebilir)')
    .setChoiceValues(['Yeşil hidrojen', 'Yenilenebilir enerji', 'Enerji politikası ve mevzuat', 'Çevre ve ÇED',
      'Lojistik ve tedarik zinciri', 'Bölgesel kalkınma'])
    .showOtherOption(true).setRequired(true);
  form.addMultipleChoiceItem().setTitle('A4. Mesleki deneyim süresi')
    .setChoiceValues(['1–5 yıl', '6–10 yıl', '11–15 yıl', '16 yıl ve üzeri']).setRequired(true);
  form.addMultipleChoiceItem().setTitle('A5. ÇED, imar veya şebeke bağlantısı izin süreçlerinde doğrudan deneyiminiz var mı?')
    .setChoiceValues(['Evet', 'Hayır']).setRequired(true);

  // ── Bölüm B — Saha bilgi kartı ────────────────────────────────────
  form.addPageBreakItem().setTitle('Bölüm B — Saha bilgi kartı')
    .setHelpText(
      'Bilgiler tüm sahalar için aynı yapıda ve doğrulanmış kaynaklardan verilmiştir. Değerlendirdiğiniz kriterlere ' +
      'ilişkin performans değerleri (mesafeler, kaynak ve tehlike değerleri) görüşlerinizi yönlendirmemesi için bilinçli olarak verilmemiştir.\n\n' +
      'S1 — Karaman / Merkez · teşvik bölgesi 3\n' +
      'S2 — Kahramanmaraş / Afşin · teşvik bölgesi 5\n' +
      'S3 — Şanlıurfa / Viranşehir · teşvik bölgesi 6\n' +
      'S4 — Kayseri / Develi · teşvik bölgesi 2\n' +
      'S5 — Kırklareli / Pınarhisar · teşvik bölgesi 3\n\n' +
      'Tüm sahalarda uygun alanın baskın arazi örtüsü çayır-çalı / çıplak arazidir (ESA WorldCover 2021). ' +
      'Teşvik bölgeleri: Karar 9903, EK-2 (RG 30.05.2025); 1 = en gelişmiş … 6 = en yüksek destek.');
  const mapBlob = Utilities.newBlob(Utilities.base64Decode(SITE_MAP_PNG_B64), 'image/png', 'site_map.png');
  form.addImageItem().setTitle('Aday sahaların konumu').setImage(mapBlob);
  // Bölge tanıma sorusu, sahaların konumu gösterildikten sonra sorulur
  form.addGridItem().setTitle('B1. Yukarıdaki aday sahaların bulunduğu bölgeleri (il/ilçe ölçeğinde) ne kadar tanıyorsunuz?')
    .setHelpText('1 = Hiç tanımıyorum … 5 = Çok iyi tanıyorum (bölgede çalıştım veya proje yürüttüm)')
    .setRows(SITES)
    .setColumns(['1', '2', '3', '4', '5']).setRequired(true);

  // ── Bölüm C — Kriterlerin önemi ───────────────────────────────────
  form.addPageBreakItem().setTitle('Bölüm C — Kriterlerin önem derecesi')
    .setHelpText(
      'Türkiye\'de yeşil hidrojen üretim tesisi için aday sahalar sıralanırken aşağıdaki her kriterin ne kadar önemli ' +
      'olması gerektiğini değerlendiriniz. Bir sahayı değil, yalnızca kriterin genel önemini puanlayınız. Bazı kriterler ' +
      'araştırma ekibi tarafından veriyle hesaplanmaktadır; önemlerine ilişkin görüşünüz yine de gereklidir.\n\n' +
      '1 = Kesinlikle önemsiz … 5 = Eşit / orta derecede önemli … 9 = Kesinlikle önemli');
  form.addGridItem().setTitle('C. Kriterlerin önemi')
    .setRows([
      'K1 — Şebeke bağlantı yakınlığı: 154 kV ve üzeri en yakın trafo merkezine uzaklık',
      'K2 — Su stresi: havzada su talebinin yenilenebilir su arzına oranı (yüksek stres olumsuz)',
      'K3 — Ekolojik hassasiyet: korunan ve önemli doğa alanlarına yakınlık (yasal tamponun ötesinde)',
      'K4 — Deprem tehlikesi: deprem yer hareketi tehlikesi ve aktif faylara yakınlık',
      'K5 — Yerel toplumsal kabul: yerel halk ve yönetimlerce çatışmasız kabul olasılığı',
      'K6 — İzin, arazi edinimi ve mevzuat hazırlığı: ÇED, imar, mülkiyet, şebeke/su izinleri, idari kapasite',
      'K7 — Sanayi-lojistik ekosistemi ve nitelikli iş gücü'])
    .setColumns(SCALE9).setRequired(true);

  // ── Bölüm D — Sahaların değerlendirilmesi ─────────────────────────
  form.addPageBreakItem().setTitle('Bölüm D — Sahaların değerlendirilmesi')
    .setHelpText(
      'Aşağıdaki üç kriterin her biri için beş aday sahayı 1–9 ölçeğinde değerlendiriniz. Açıklamalar 1, 3, 5, 7 ve 9 ' +
      'için verilmiştir; 2, 4, 6 ve 8 ara değerlerdir. Tüm sorularda 9 en elverişli durumu gösterir. Bir saha hakkında ' +
      'yeterli bilginiz yoksa tahmin yürütmek yerine "Bilgim yok" seçeneğini işaretleyiniz.');
  form.addGridItem().setTitle('D1. Yerel toplumsal kabul')
    .setHelpText(
      'Aday sahada büyük ölçekli bir yeşil hidrojen üretim tesisinin (elektrolizör, ilişkili rüzgâr ve güneş santrali, ' +
      'şebeke bağlantısı) yerel halk ve yerel yönetimler tarafından örgütlü muhalefet, dava süreci veya uzun süreli ' +
      'çatışma yaşanmadan kabul görme olasılığını nasıl değerlendirirsiniz?\n' +
      'Göz önünde bulundurulabilecek hususlar: önceki enerji ve sanayi yatırımlarına ilişkin deneyimler; yerel ekonominin ' +
      'tarım, hayvancılık veya turizme bağımlılığı; hidrojen güvenliğine ilişkin algılar; yatırımcıya ve kamu kurumlarına ' +
      'güven; arazi ve su kullanımında rekabet.\n\n' +
      '1 = Çok güçlü muhalefet; proje büyük olasılıkla engellenir ya da ciddi biçimde gecikir.\n' +
      '3 = Belirgin itirazlar; kabul kapsamlı tavizlerle ve belirsiz koşullarda mümkün.\n' +
      '5 = Karışık veya nötr; belirgin destek ya da muhalefet beklentisi yok.\n' +
      '7 = Genel olarak kabul ve geniş yerel destek; kaygılar olağan katılım süreçleriyle giderilebilir.\n' +
      '9 = Çok güçlü destek; çatışma olasılığı çok düşük.')
    .setRows(SITES).setColumns(SCALE9_NB).setRequired(true);
  form.addGridItem().setTitle('D2. İzin, arazi edinimi ve mevzuat hazırlığı')
    .setHelpText(
      'Aday sahada büyük ölçekli bir yeşil hidrojen tesisi için gerekli izinlerin ve arazi haklarının makul bir sürede ' +
      'elde edilebilmesine ilişkin koşulları nasıl değerlendirirsiniz? (ÇED süreci; imar ve plan durumu; arazi mülkiyeti — ' +
      'Hazine, mera veya özel mülk; şebeke bağlantı onayı ve su kullanım izni; il ve bölge düzeyindeki idari kapasite)\n\n' +
      '1 = Çok elverişsiz; ciddi hukuki veya mülkiyet engelleri, son derece uzun ya da belirsiz izin süreci.\n' +
      '3 = Elverişsiz; önemli engeller ve belirgin gecikme riski.\n' +
      '5 = Ortalama; olağan izin süreci ve olağan riskler.\n' +
      '7 = Elverişli; sınırlı engel, büyük ölçüde açık ve öngörülebilir izin yolları.\n' +
      '9 = Çok elverişli; arazi hazır, izin yolları yerleşik, belirgin gecikme beklenmez.')
    .setRows(SITES).setColumns(SCALE9_NB).setRequired(true);
  form.addGridItem().setTitle('D3. Sanayi-lojistik ekosistemi ve nitelikli iş gücü')
    .setHelpText(
      'Aday sahanın çevresi, bir yeşil hidrojen tesisinin kurulması ve işletilmesi için gereken destekleyici ekosistemi ' +
      'ne ölçüde sunmaktadır? (nitelikli teknik iş gücü; mühendislik/EPC ve bakım-onarım hizmetleri; organize sanayi ' +
      'bölgeleri; karayolu, demiryolu, liman veya boru hattı erişimi)\n\n' +
      '1 = Çok zayıf; iş gücü ve hizmetler büyük ölçüde dışarıdan, lojistik bağlantılar çok sınırlı.\n' +
      '3 = Zayıf; temel hizmetler var, uzmanlık büyük ölçüde dışarıdan.\n' +
      '5 = Orta; kurulum için yeterli, işletmede kısmi dış destek gerekir.\n' +
      '7 = Güçlü; deneyimli iş gücü, OSB ve iyi lojistik bağlantılar mevcut.\n' +
      '9 = Çok güçlü; nitelikli iş gücü, EPC ve bakım hizmetleri, OSB ve çok modlu lojistik bölgede hazır.')
    .setRows(SITES).setColumns(SCALE9_NB).setRequired(true);

  // ── Bölüm E — Görüşler ────────────────────────────────────────────
  form.addPageBreakItem().setTitle('Bölüm E — Görüş ve öneriler (isteğe bağlı)');
  form.addParagraphTextItem().setTitle('E1. Yedi kriter dışında, aday sahaların sıralanmasında dikkate alınması gerektiğini düşündüğünüz bir husus var mı?');
  form.addParagraphTextItem().setTitle('E2. Türkiye\'de yeşil hidrojen tedarik zinciri kurulumunda öngördüğünüz başlıca riskler nelerdir?');

  Logger.log('Düzenleme bağlantısı: ' + form.getEditUrl());
  Logger.log('Yanıt bağlantısı:     ' + form.getPublishedUrl());
}

// Konum haritası (PNG, base64) — survey/assets/site_map_small.png
const SITE_MAP_PNG_B64 = '';
